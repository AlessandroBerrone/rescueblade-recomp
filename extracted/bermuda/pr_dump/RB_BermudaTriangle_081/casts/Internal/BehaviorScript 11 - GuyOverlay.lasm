property this, Xpos, leftLoopX, rightLoopX, loopWidth, radians, Ypos, overlayState, startHeight, startWidth, cableGuy, splashHeight, splashVel, grav
global gXVel, gXOffset, gPaused

on beginSprite
  [  0] pusharglist 0 ........................... <>
  [  2] extcall 41 .............................. <PI>
  [  5] pushint8 180 ............................ <180>
  [  8] div ..................................... <PI / 180>
  [  9] pusharglist 1 ........................... <PI / 180>
  [ 11] extcall 33 .............................. <float(PI / 180)>
  [ 14] setprop 40 .............................. radians = float(PI / 180)
  [ 17] getmovieprop 22 ......................... <the currentSpriteNum>
  [ 19] pusharglist 1 ........................... <the currentSpriteNum>
  [ 21] extcall 21 .............................. <sprite(the currentSpriteNum)>
  [ 23] setprop 20 .............................. this = sprite(the currentSpriteNum)
  [ 25] pushint8 512 ............................ <512>
  [ 28] getprop 20 .............................. <this>
  [ 30] getobjprop 50 ........................... <this.width>
  [ 33] pushint8 2 .............................. <2>
  [ 36] div ..................................... <this.width / 2>
  [ 37] add ..................................... <512 + (this.width / 2)>
  [ 38] setprop 53 .............................. rightLoopX = 512 + (this.width / 2)
  [ 41] getprop 20 .............................. <this>
  [ 43] getobjprop 50 ........................... <this.width>
  [ 46] inv ..................................... <-this.width>
  [ 47] pushint8 2 .............................. <2>
  [ 50] div ..................................... <-this.width / 2>
  [ 51] setprop 52 .............................. leftLoopX = -this.width / 2
  [ 54] pushint8 512 ............................ <512>
  [ 57] getprop 20 .............................. <this>
  [ 59] getobjprop 50 ........................... <this.width>
  [ 62] add ..................................... <512 + this.width>
  [ 63] setprop 54 .............................. loopWidth = 512 + this.width
  [ 66] getprop 20 .............................. <this>
  [ 68] getobjprop 36 ........................... <this.locH>
  [ 71] pusharglist 1 ........................... <this.locH>
  [ 73] extcall 33 .............................. <float(this.locH)>
  [ 76] setprop 48 .............................. Xpos = float(this.locH)
  [ 79] getprop 20 .............................. <this>
  [ 81] getobjprop 37 ........................... <this.locV>
  [ 84] pusharglist 1 ........................... <this.locV>
  [ 86] extcall 33 .............................. <float(this.locV)>
  [ 89] setprop 38 .............................. Ypos = float(this.locV)
  [ 92] getprop 20 .............................. <this>
  [ 94] pushint8 102 ............................ <102>
  [ 97] setobjprop 178 .......................... this.locZ = 102
  [100] getprop 20 .............................. <this>
  [102] getobjprop 97 ........................... <this.height>
  [105] setprop 400 ............................. startHeight = this.height
  [108] getprop 20 .............................. <this>
  [110] getobjprop 50 ........................... <this.width>
  [113] setprop 401 ............................. startWidth = this.width
  [116] getprop 20 .............................. <this>
  [118] pushzero ................................ <0>
  [119] setobjprop 173 .......................... this.blend = 0
  [122] pushsymb 399 ............................ <#NULL>
  [125] setprop 404 ............................. overlayState = #NULL
  [128] getprop 400 ............................. <startHeight>
  [131] pushcons 0 .............................. <0.5>
  [133] mul ..................................... <startHeight * 0.5>
  [134] setprop 405 ............................. splashHeight = startHeight * 0.5
  [137] pushint8 7 .............................. <7>
  [140] setprop 406 ............................. splashVel = 7
  [143] pushcons 8 .............................. <0.25>
  [145] inv ..................................... <-0.25>
  [146] setprop 34 .............................. grav = -0.25
  [149] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [250] ............................ if gPaused = 0 then
  [  8] getprop 404 ............................. <overlayState>
  [ 11] peek 0 .................................. case overlayState of
  [ 13] pushsymb 399 ............................ <#NULL>
  [ 16] eq
  [ 17] jmpifz [ 39] ............................ (case) #NULL:
  [ 20] getprop 20 .............................. <this>
  [ 22] getprop 48 .............................. <Xpos>
  [ 25] setobjprop 36 ........................... this.locH = Xpos
  [ 28] getprop 20 .............................. <this>
  [ 30] getprop 38 .............................. <Ypos>
  [ 33] setobjprop 37 ........................... this.locV = Ypos
  [ 36] jmp [248]
  [ 39] peek 0
  [ 41] pushsymb 402 ............................ <#StartSplash>
  [ 44] eq
  [ 45] jmpifz [110] ............................ (case) #StartSplash:
  [ 48] getprop 20 .............................. <this>
  [ 50] pushint8 100 ............................ <100>
  [ 53] setobjprop 173 .......................... this.blend = 100
  [ 56] getprop 20 .............................. <this>
  [ 58] getprop 400 ............................. <startHeight>
  [ 61] pushcons 16 ............................. <0.5>
  [ 63] mul ..................................... <startHeight * 0.5>
  [ 64] setobjprop 97 ........................... this.height = startHeight * 0.5
  [ 67] getprop 20 .............................. <this>
  [ 69] getprop 401 ............................. <startWidth>
  [ 72] setobjprop 50 ........................... this.width = startWidth
  [ 75] pushsymb 403 ............................ <#SPLASH>
  [ 78] setprop 404 ............................. overlayState = #SPLASH
  [ 81] getprop 20 .............................. <this>
  [ 83] getprop 48 .............................. <Xpos>
  [ 86] setobjprop 36 ........................... this.locH = Xpos
  [ 89] getprop 20 .............................. <this>
  [ 91] getprop 38 .............................. <Ypos>
  [ 94] setobjprop 37 ........................... this.locV = Ypos
  [ 97] pushzero ................................ <0>
  [ 98] setprop 405 ............................. splashHeight = 0
  [101] pushint8 7 .............................. <7>
  [104] setprop 406 ............................. splashVel = 7
  [107] jmp [248]
  [110] peek 0
  [112] pushsymb 403 ............................ <#SPLASH>
  [115] eq
  [116] jmpifz [248] ............................ (case) #SPLASH:
  [119] getprop 406 ............................. <splashVel>
  [122] getprop 34 .............................. <grav>
  [125] add ..................................... <splashVel + grav>
  [126] setprop 406 ............................. splashVel = splashVel + grav
  [129] getprop 405 ............................. <splashHeight>
  [132] getprop 406 ............................. <splashVel>
  [135] add ..................................... <splashHeight + splashVel>
  [136] setprop 405 ............................. splashHeight = splashHeight + splashVel
  [139] getprop 20 .............................. <this>
  [141] getprop 405 ............................. <splashHeight>
  [144] setobjprop 97 ........................... this.height = splashHeight
  [147] getprop 20 .............................. <this>
  [149] getprop 401 ............................. <startWidth>
  [152] pushint8 5 .............................. <5>
  [155] add ..................................... <startWidth + 5>
  [156] getprop 405 ............................. <splashHeight>
  [159] pushcons 24 ............................. <0.10000000000000001>
  [161] mul ..................................... <splashHeight * 0.10000000000000001>
  [162] sub ..................................... <startWidth + 5 - (splashHeight * 0.10000000000000001)>
  [163] setobjprop 50 ........................... this.width = startWidth + 5 - (splashHeight * 0.10000000000000001)
  [166] getprop 406 ............................. <splashVel>
  [169] pushzero ................................ <0>
  [170] lt ...................................... <splashVel < 0>
  [171] jmpifz [218] ............................ if splashVel < 0 then
  [174] getprop 20 .............................. <this>
  [176] getprop 20 .............................. <this>
  [178] getobjprop 173 .......................... <this.blend>
  [181] pushint8 1 .............................. <1>
  [184] sub ..................................... <this.blend - 1>
  [185] setobjprop 173 .......................... this.blend = this.blend - 1
  [188] getprop 20 .............................. <this>
  [190] getobjprop 173 .......................... <this.blend>
  [193] pushzero ................................ <0>
  [194] eq ...................................... <this.blend = 0>
  [195] jmpifz [218] ............................ if this.blend = 0 then
  [198] pushsymb 399 ............................ <#NULL>
  [201] setprop 404 ............................. overlayState = #NULL
  [204] pushint8 1000 ........................... <1000>
  [207] inv ..................................... <-1000>
  [208] setprop 48 .............................. Xpos = -1000
  [211] pushint8 1000 ........................... <1000>
  [214] inv ..................................... <-1000>
  [215] setprop 38 .............................. Ypos = -1000
  [218] getprop 48 .............................. <Xpos>
  [221] getglobal 47 ............................ <gXVel>
  [224] add ..................................... <Xpos + gXVel>
  [225] getglobal 55 ............................ <gXOffset>
  [228] add ..................................... <Xpos + gXVel + gXOffset>
  [229] setprop 48 .............................. Xpos = Xpos + gXVel + gXOffset
  [232] getprop 20 .............................. <this>
  [234] getprop 48 .............................. <Xpos>
  [237] setobjprop 36 ........................... this.locH = Xpos
  [240] getprop 20 .............................. <this>
  [242] getprop 38 .............................. <Ypos>
  [245] setobjprop 37 ........................... this.locV = Ypos
  [248] pop 1 ................................... end case
  [250] ret
end
