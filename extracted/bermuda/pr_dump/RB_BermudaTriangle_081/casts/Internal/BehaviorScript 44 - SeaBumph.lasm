global gTileHeightList

on beginSprite
  [  0] pushzero ................................ <0>
  [  1] setlocal 0 .............................. delayCount = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setlocal 8 .............................. gSeaFrame = 1
  [  8] pushint8 1 .............................. <1>
  [ 11] setlocal 16
  [ 13] getlocal 16
  [ 15] getglobal 182 ........................... <gTileHeightList>
  [ 18] getobjprop 183 .......................... <gTileHeightList.count>
  [ 21] lteq
  [ 22] jmpifz [ 54] ............................ repeat with i = 1 to gTileHeightList.count
  [ 25] getglobal 182 ........................... <gTileHeightList>
  [ 28] getlocal 16 ............................. <i>
  [ 30] pushint8 50 ............................. <50>
  [ 33] pusharglist 1 ........................... <50>
  [ 35] extcall 408 ............................. <random(50)>
  [ 38] pusharglistnoret 3 ...................... <gTileHeightList, i, random(50)>
  [ 40] objcall 181 ............................. gTileHeightList[i] = random(50)
  [ 43] pushint8 1
  [ 46] getlocal 16
  [ 48] add
  [ 49] setlocal 16
  [ 51] endrepeat [ 13]
  [ 54] ret
end

on exitFrame
  [  0] pushint8 1 .............................. <1>
  [  3] setlocal 0
  [  5] getlocal 0
  [  7] getglobal 182 ........................... <gTileHeightList>
  [ 10] getobjprop 183 .......................... <gTileHeightList.count>
  [ 13] lteq
  [ 14] jmpifz [ 71] ............................ repeat with i = 1 to gTileHeightList.count
  [ 17] getglobal 182 ........................... <gTileHeightList>
  [ 20] getlocal 0 .............................. <i>
  [ 22] pusharglist 2 ........................... <gTileHeightList, i>
  [ 24] objcall 185 ............................. <gTileHeightList[i]>
  [ 27] setlocal 8 .............................. temp = gTileHeightList[i]
  [ 29] getlocal 8 .............................. <temp>
  [ 31] pushcons 0 .............................. <0.94999999999999996>
  [ 33] mul ..................................... <temp * 0.94999999999999996>
  [ 34] setlocal 8 .............................. temp = temp * 0.94999999999999996
  [ 36] getlocal 8 .............................. <temp>
  [ 38] pushint8 1 .............................. <1>
  [ 41] lt ...................................... <temp < 1>
  [ 42] jmpifz [ 48] ............................ if temp < 1 then
  [ 45] pushzero ................................ <0>
  [ 46] setlocal 8 .............................. temp = 0
  [ 48] getglobal 182 ........................... <gTileHeightList>
  [ 51] getlocal 0 .............................. <i>
  [ 53] getlocal 8 .............................. <temp>
  [ 55] pusharglistnoret 3 ...................... <gTileHeightList, i, temp>
  [ 57] objcall 181 ............................. gTileHeightList[i] = temp
  [ 60] pushint8 1
  [ 63] getlocal 0
  [ 65] add
  [ 66] setlocal 0
  [ 68] endrepeat [  5]
  [ 71] ret
end
