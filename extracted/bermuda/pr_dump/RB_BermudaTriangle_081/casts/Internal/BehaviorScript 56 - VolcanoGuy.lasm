  [185] sub ..................................... <groundHeightRight - groundHeightLeft>
  [186] setlocal 56 ............................. groundDiff = groundHeightRight - groundHeightLeft
  [188] getprop 38 .............................. <Ypos>
  [191] pushint8 10 ............................. <10>
  [194] add ..................................... <Ypos + 10>
  [195] pushint8 280 ............................ <280>
