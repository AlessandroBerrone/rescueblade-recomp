  [ 46] getprop 20 .............................. <this>
  [ 48] getprop 38 .............................. <Ypos>
  [ 51] setobjprop 37 ........................... this.locV = Ypos
  [ 54] pusharglistnoret 0 ...................... <>
  [ 56] localcall 2 ............................. doGroundHeight()
  [ 58] jmp [138]
  [ 61] peek 0
  [ 63] pushsymb 442 ............................ <#ONGROUND>
  [ 66] eq
  [ 67] jmpifz [138] ............................ (case) #ONGROUND:
  [ 70] getprop 48 .............................. <Xpos>
  [ 73] getglobal 47 ............................ <gXVel>
  [ 76] add ..................................... <Xpos + gXVel>
  [ 77] getglobal 55 ............................ <gXOffset>
  [ 80] add ..................................... <Xpos + gXVel + gXOffset>
