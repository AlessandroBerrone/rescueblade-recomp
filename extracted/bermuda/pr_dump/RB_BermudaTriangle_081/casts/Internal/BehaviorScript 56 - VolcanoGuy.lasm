  [ 84] getprop 20 .............................. <this>
  [ 86] getprop 48 .............................. <Xpos>
  [ 89] setobjprop 36 ........................... this.locH = Xpos
  [ 92] getprop 20 .............................. <this>
  [ 94] getprop 38 .............................. <Ypos>
  [ 97] getprop 876 ............................. <jump>
  [100] sub ..................................... <Ypos - jump>
  [101] setobjprop 37 ........................... this.locV = Ypos - jump
  [104] getprop 877 ............................. <jumpVel>
  [107] getprop 34 .............................. <grav>
  [110] sub ..................................... <jumpVel - grav>
  [111] setprop 877 ............................. jumpVel = jumpVel - grav
  [114] getprop 876 ............................. <jump>
  [117] getprop 877 ............................. <jumpVel>
  [120] add ..................................... <jump + jumpVel>
  [121] setprop 876 ............................. jump = jump + jumpVel
  [124] getprop 876 ............................. <jump>
  [127] pushzero ................................ <0>
  [128] lt ...................................... <jump < 0>
  [129] jmpifz [138] ............................ if jump < 0 then
  [132] pushint8 10 ............................. <10>
  [135] setprop 877 ............................. jumpVel = 10
  [138] pop 1 ................................... end case
  [140] ret
end

on doGroundHeight
