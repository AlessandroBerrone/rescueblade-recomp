on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [140] ............................ if gPaused = 0 then
  [  8] getprop 874 ............................. <guyState>
  [ 11] peek 0 .................................. case guyState of
  [ 13] pushsymb 796 ............................ <#claw>
  [ 16] eq
  [ 17] jmpifz [ 61] ............................ (case) #claw:
  [ 20] getprop 796 ............................. <claw>
  [ 23] getobjprop 36 ........................... <claw.locH>
  [ 26] setprop 48 .............................. Xpos = claw.locH
  [ 29] getprop 796 ............................. <claw>
