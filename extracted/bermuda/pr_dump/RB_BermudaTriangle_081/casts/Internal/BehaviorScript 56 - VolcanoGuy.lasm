  [122] setlocal 32 ............................. tempID = gTileIDList[mapXTile]
  [124] getglobal 182 ........................... <gTileHeightList>
  [127] getprop 367 ............................. <mapXTile>
  [130] pusharglist 2 ........................... <gTileHeightList, mapXTile>
  [132] objcall 185 ............................. <gTileHeightList[mapXTile]>
  [135] setlocal 40 ............................. groundHeightLeft = gTileHeightList[mapXTile]
  [137] getprop 367 ............................. <mapXTile>
