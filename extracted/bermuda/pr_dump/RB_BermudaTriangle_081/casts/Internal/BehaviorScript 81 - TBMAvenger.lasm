  [114] extcall 33 .............................. <float(cableGuy.locH - this.locH)>
  [117] setlocal 0 .............................. xDiff = float(cableGuy.locH - this.locH)
  [119] getprop 342 ............................. <cableGuy>
  [122] getobjprop 37 ........................... <cableGuy.locV>
  [125] getprop 20 .............................. <this>
