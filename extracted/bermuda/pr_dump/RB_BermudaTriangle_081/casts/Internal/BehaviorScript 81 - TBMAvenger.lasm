property this, Xpos, radians, Ypos, podsFront, loopX, loopWidth, cableGuy, COPTER, firstPhoto
global gXVel, gXOffset, gPaused, gTileIDList, gXVelChange, gScore

on beginSprite
  [  0] pusharglist 0 ........................... <>
  [  2] extcall 41 .............................. <PI>
