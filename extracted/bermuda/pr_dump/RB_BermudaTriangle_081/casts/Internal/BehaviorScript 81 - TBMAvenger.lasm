  [212] getlocal 16 ............................. <distToCopter>
  [214] pushcons 16 ............................. <200.0>
  [216] div ..................................... <distToCopter / 200.0>
  [217] sub ..................................... <1 - (distToCopter / 200.0)>
  [218] mul ..................................... <1000 * (1 - (distToCopter / 200.0))>
