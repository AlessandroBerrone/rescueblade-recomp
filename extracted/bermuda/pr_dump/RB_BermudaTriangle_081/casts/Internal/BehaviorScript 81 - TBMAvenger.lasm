  [133] extcall 33 .............................. <float(cableGuy.locV - this.locV)>
  [136] setlocal 8 .............................. yDiff = float(cableGuy.locV - this.locV)
  [138] getlocal 0 .............................. <xDiff>
  [140] getlocal 0 .............................. <xDiff>
  [142] mul ..................................... <xDiff * xDiff>
  [143] getlocal 8 .............................. <yDiff>
  [145] getlocal 8 .............................. <yDiff>
  [147] mul ..................................... <yDiff * yDiff>
