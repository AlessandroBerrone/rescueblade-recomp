  [151] extcall 343 ............................. <sqrt((xDiff * xDiff) + (yDiff * yDiff))>
  [154] setlocal 16 ............................. distToCopter = sqrt((xDiff * xDiff) + (yDiff * yDiff))
  [156] getlocal 16 ............................. <distToCopter>
  [158] pushint8 200 ............................ <200>
  [161] lt ...................................... <distToCopter < 200>
  [162] jmpifz [250] ............................ if distToCopter < 200 then
