property delayCount
global gSeaFrame

on beginSprite
  [  0] pushzero ................................ <0>
  [  1] setprop 28 .............................. delayCount = 0
  [  3] pushint8 1 .............................. <1>
  [  6] setglobal 274 ........................... gSeaFrame = 1
  [  9] ret
end

on exitFrame
  [  0] getprop 28 .............................. <delayCount>
  [  2] pushint8 1 .............................. <1>
  [  5] add ..................................... <delayCount + 1>
  [  6] setprop 28 .............................. delayCount = delayCount + 1
  [  8] getprop 28 .............................. <delayCount>
  [ 10] pushint8 3 .............................. <3>
  [ 13] gt ...................................... <delayCount > 3>
  [ 14] jmpifz [ 46] ............................ if delayCount > 3 then
  [ 17] getglobal 274 ........................... <gSeaFrame>
  [ 20] pushint8 1 .............................. <1>
  [ 23] add ..................................... <gSeaFrame + 1>
  [ 24] setglobal 274 ........................... gSeaFrame = gSeaFrame + 1
  [ 27] getglobal 274 ........................... <gSeaFrame>
  [ 30] pushint8 20 ............................. <20>
  [ 33] gt ...................................... <gSeaFrame > 20>
  [ 34] jmpifz [ 43] ............................ if gSeaFrame > 20 then
  [ 37] pushint8 1 .............................. <1>
  [ 40] setglobal 274 ........................... gSeaFrame = 1
  [ 43] pushzero ................................ <0>
  [ 44] setprop 28 .............................. delayCount = 0
  [ 46] ret
end
