  [216] setobjprop 173 .......................... this.blend = this.blend - 2
  [219] getprop 20 .............................. <this>
  [221] getobjprop 173 .......................... <this.blend>
  [224] pushzero ................................ <0>
  [225] eq ...................................... <this.blend = 0>
  [226] jmpifz [283] ............................ if this.blend = 0 then
  [229] pushsymb 399 ............................ <#NULL>
  [232] setprop 465 ............................. smokeState = #NULL
  [235] getglobal 464 ........................... <gSmokeList>
  [238] getprop 20 .............................. <this>
  [240] pusharglistnoret 2 ...................... <gSmokeList, this>
  [242] objcall 418 ............................. gSmokeList.add(this)
  [245] pushint8 1000 ........................... <1000>
  [248] inv ..................................... <-1000>
  [249] setprop 48 .............................. Xpos = -1000
  [252] pushint8 1000 ........................... <1000>
  [255] inv ..................................... <-1000>
  [256] setprop 38 .............................. Ypos = -1000
  [259] getprop 20 .............................. <this>
  [261] pushint8 1 .............................. <1>
  [264] setobjprop 50 ........................... this.width = 1
  [267] getprop 20 .............................. <this>
  [269] pushint8 1 .............................. <1>
  [272] setobjprop 97 ........................... this.height = 1
  [275] getprop 20 .............................. <this>
  [277] pushint8 100 ............................ <100>
  [280] setobjprop 173 .......................... this.blend = 100
  [283] getprop 20 .............................. <this>
  [285] getprop 48 .............................. <Xpos>
  [288] setobjprop 36 ........................... this.locH = Xpos
  [291] getprop 20 .............................. <this>
  [293] getprop 38 .............................. <Ypos>
  [296] setobjprop 37 ........................... this.locV = Ypos
  [299] pop 1 ................................... end case
  [301] ret
end
