  [ 36] getprop 48 .............................. <Xpos>
  [ 39] setobjprop 36 ........................... this.locH = Xpos
  [ 42] getprop 20 .............................. <this>
  [ 44] getprop 38 .............................. <Ypos>
  [ 47] setobjprop 37 ........................... this.locV = Ypos
  [ 50] pushint8 10 ............................. <10>
  [ 53] pusharglist 1 ........................... <10>
  [ 55] extcall 408 ............................. <random(10)>
  [ 58] setlocal 0 .............................. rand = random(10)
  [ 60] getprop 20 .............................. <this>
  [ 62] getlocal 0 .............................. <rand>
  [ 64] setobjprop 50 ........................... this.width = rand
  [ 67] getprop 20 .............................. <this>
  [ 69] getlocal 0 .............................. <rand>
  [ 71] setobjprop 97 ........................... this.height = rand
  [ 74] getprop 20 .............................. <this>
  [ 76] pushint8 100 ............................ <100>
  [ 79] setobjprop 173 .......................... this.blend = 100
  [ 82] jmp [299]
  [ 85] peek 0
  [ 87] pushsymb 467 ............................ <#SMOKE>
  [ 90] eq
  [ 91] jmpifz [299] ............................ (case) #SMOKE:
  [ 94] getprop 48 .............................. <Xpos>
  [ 97] getglobal 47 ............................ <gXVel>
  [100] add ..................................... <Xpos + gXVel>
  [101] getglobal 55 ............................ <gXOffset>
  [104] add ..................................... <Xpos + gXVel + gXOffset>
  [105] setprop 48 .............................. Xpos = Xpos + gXVel + gXOffset
  [108] getprop 38 .............................. <Ypos>
