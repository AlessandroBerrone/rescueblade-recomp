  [124] getprop 466 ............................. <rotWise>
  [127] pushint8 3 .............................. <3>
  [130] mul ..................................... <rotWise * 3>
  [131] add ..................................... <this.rotation + (rotWise * 3)>
  [132] setobjprop 25 ........................... this.rotation = this.rotation + (rotWise * 3)
  [134] getprop 20 .............................. <this>
  [136] getobjprop 50 ........................... <this.width>
  [139] pushint8 50 ............................. <50>
  [142] lt ...................................... <this.width < 50>
  [143] jmpifz [177] ............................ if this.width < 50 then / else
  [146] getprop 20 .............................. <this>
  [148] getprop 20 .............................. <this>
  [150] getobjprop 50 ........................... <this.width>
  [153] pushint8 2 .............................. <2>
  [156] add ..................................... <this.width + 2>
  [157] setobjprop 50 ........................... this.width = this.width + 2
  [160] getprop 20 .............................. <this>
  [162] getprop 20 .............................. <this>
  [164] getobjprop 97 ........................... <this.height>
  [167] pushint8 2 .............................. <2>
  [170] add ..................................... <this.height + 2>
  [171] setobjprop 97 ........................... this.height = this.height + 2
  [174] jmp [205]
  [177] getprop 20 .............................. <this>
  [179] getprop 20 .............................. <this>
  [181] getobjprop 50 ........................... <this.width>
  [184] pushint8 2 .............................. <2>
  [187] add ..................................... <this.width + 2>
  [188] setobjprop 50 ........................... this.width = this.width + 2
  [191] getprop 20 .............................. <this>
  [193] getprop 20 .............................. <this>
  [195] getobjprop 97 ........................... <this.height>
  [198] pushint8 2 .............................. <2>
  [201] add ..................................... <this.height + 2>
