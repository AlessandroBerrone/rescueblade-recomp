property this, Xpos, Ypos, smokeState, rotWise, Yvel
global gXVel, gXOffset, gPaused, gSmokeList

on beginSprite
  [  0] getmovieprop 22 ......................... <the currentSpriteNum>
  [  2] pusharglist 1 ........................... <the currentSpriteNum>
  [  4] extcall 21 .............................. <sprite(the currentSpriteNum)>
  [  6] setprop 20 .............................. this = sprite(the currentSpriteNum)
  [  8] pushint8 1000 ........................... <1000>
  [ 11] inv ..................................... <-1000>
  [ 12] pusharglist 1 ........................... <-1000>
  [ 14] extcall 33 .............................. <float(-1000)>
  [ 17] setprop 48 .............................. Xpos = float(-1000)
  [ 20] pushint8 1000 ........................... <1000>
  [ 23] inv ..................................... <-1000>
  [ 24] pusharglist 1 ........................... <-1000>
  [ 26] extcall 33 .............................. <float(-1000)>
  [ 29] setprop 38 .............................. Ypos = float(-1000)
  [ 32] pushint8 2 .............................. <2>
  [ 35] inv ..................................... <-2>
  [ 36] setprop 32 .............................. Yvel = -2
  [ 39] pushsymb 399 ............................ <#NULL>
  [ 42] setprop 465 ............................. smokeState = #NULL
  [ 45] getprop 20 .............................. <this>
  [ 47] pushint8 105 ............................ <105>
  [ 50] setobjprop 178 .......................... this.locZ = 105
  [ 53] getglobal 464 ........................... <gSmokeList>
  [ 56] getprop 20 .............................. <this>
  [ 58] pusharglistnoret 2 ...................... <gSmokeList, this>
  [ 60] objcall 418 ............................. gSmokeList.add(this)
  [ 63] pushint8 2 .............................. <2>
  [ 66] pusharglist 1 ........................... <2>
  [ 68] extcall 408 ............................. <random(2)>
  [ 71] setprop 466 ............................. rotWise = random(2)
  [ 74] getprop 466 ............................. <rotWise>
  [ 77] pushint8 2 .............................. <2>
  [ 80] eq ...................................... <rotWise = 2>
  [ 81] jmpifz [ 91] ............................ if rotWise = 2 then
  [ 84] pushint8 1 .............................. <1>
  [ 87] inv ..................................... <-1>
  [ 88] setprop 466 ............................. rotWise = -1
  [ 91] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [301] ............................ if gPaused = 0 then
  [  8] getprop 465 ............................. <smokeState>
  [ 11] peek 0 .................................. case smokeState of
  [ 13] pushsymb 399 ............................ <#NULL>
  [ 16] eq
  [ 17] jmpifz [ 85] ............................ (case) #NULL:
  [ 20] pushint8 1000 ........................... <1000>
  [ 23] inv ..................................... <-1000>
  [ 24] setprop 48 .............................. Xpos = -1000
  [ 27] pushint8 1000 ........................... <1000>
  [ 30] inv ..................................... <-1000>
  [ 31] setprop 38 .............................. Ypos = -1000
