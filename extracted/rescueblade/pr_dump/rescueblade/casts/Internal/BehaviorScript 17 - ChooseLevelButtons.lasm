  [ 12] getprop 20 .............................. <this>
  [ 14] pushint8 100 ............................ <100>
  [ 17] setobjprop 173 .......................... this.blend = 100
  [ 20] jmp [ 31]
  [ 23] getprop 20 .............................. <this>
  [ 25] pushint8 50 ............................. <50>
  [ 28] setobjprop 173 .......................... this.blend = 50
  [ 31] ret
end

