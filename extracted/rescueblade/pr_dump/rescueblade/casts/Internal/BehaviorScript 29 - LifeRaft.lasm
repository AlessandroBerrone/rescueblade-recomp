  [152] pushint8 1 .............................. <1>
  [155] setlocal 8
  [157] getlocal 8
  [159] pushint8 90 ............................. <90>
  [162] lteq
  [163] jmpifz [208] ............................ repeat with i = 1 to 90
  [166] getlocal 8 .............................. <i>
  [168] pushint8 4 .............................. <4>
  [171] mul ..................................... <i * 4>
  [172] setlocal 0 .............................. swellAngle = i * 4
  [174] getprop 583 ............................. <swellList>
  [177] getprop 775 ............................. <swellHeight>
  [180] getlocal 0 .............................. <swellAngle>
  [182] getprop 40 .............................. <radians>
