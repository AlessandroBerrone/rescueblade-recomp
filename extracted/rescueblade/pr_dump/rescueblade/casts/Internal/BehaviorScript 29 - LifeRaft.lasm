  [ 26] pusharglistnoret 3 ...................... <descriptionList, #swellHeight, [#default: 0, #format: #sprite, #comment: "Sea Swell Height"]>
  [ 28] extcall 611 ............................. addProp(descriptionList, #swellHeight, [#default: 0, #format: #sprite, #comment: "Sea Swell Height"])
  [ 31] getlocal 0 .............................. <descriptionList>
  [ 33] pushsymb 776 ............................ <#swellListPointerStart>
  [ 36] pushsymb 9 .............................. <#default>
  [ 38] pushint8 1 .............................. <1>
  [ 41] pushsymb 70 ............................. <#format>
  [ 44] pushsymb 21 ............................. <#sprite>
  [ 46] pushsymb 64 ............................. <#comment>
  [ 49] pushcons 8 .............................. <"SwellListPointer Start">
  [ 51] pusharglist 6 ........................... <[#default: 1, #format: #sprite, #comment: "SwellListPointer Start"]>
  [ 53] pushproplist ............................ <[#default: 1, #format: #sprite, #comment: "SwellListPointer Start"]>
  [ 54] pusharglistnoret 3 ...................... <descriptionList, #swellListPointerStart, [#default: 1, #format: #sprite, #comment: "SwellListPointer Start"]>
  [ 56] extcall 611 ............................. addProp(descriptionList, #swellListPointerStart, [#default: 1, #format: #sprite, #comment: "SwellListPointer Start"])
  [ 59] getlocal 0 .............................. <descriptionList>
  [ 61] pusharglistnoret 1 ...................... <descriptionList>
  [ 63] extcall 2 ............................... return descriptionList
  [ 65] ret
end

on beginSprite
  [  0] pusharglist 0 ........................... <>
