  [197] pushint8 1
  [200] getlocal 8
  [202] add
  [203] setlocal 8
  [205] endrepeat [157]
  [208] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [206] ............................ if gPaused = 0 then
