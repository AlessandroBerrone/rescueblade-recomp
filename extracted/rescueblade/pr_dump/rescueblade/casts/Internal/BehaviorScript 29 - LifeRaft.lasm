on getPropertyDescriptionList me
  [  0] pusharglist 0 ........................... <[:]>
  [  2] pushproplist ............................ <[:]>
  [  3] setlocal 0 .............................. descriptionList = [:]
  [  5] getlocal 0 .............................. <descriptionList>
  [  7] pushsymb 775 ............................ <#swellHeight>
  [ 10] pushsymb 9 .............................. <#default>
  [ 12] pushzero ................................ <0>
  [ 13] pushsymb 70 ............................. <#format>
