on mouseDown me
  [  0] getparam 0 .............................. <me>
  [  2] pusharglistnoret 1 ...................... <me>
  [  4] localcall 4 ............................. initList(me)
  [  6] ret
end

on mouseUp me
  [  0] getparam 0 .............................. <me>
  [  2] pusharglistnoret 1 ...................... <me>
  [  4] localcall 6 ............................. branchToScores(me)
  [  6] ret
end

on initList me
  [  0] getglobal 697 ........................... <gSwScoreSetupList>
  [  3] pusharglist 1 ........................... <gSwScoreSetupList>
  [  5] extcall 696 ............................. <listp(gSwScoreSetupList)>
  [  8] not ..................................... <not listp(gSwScoreSetupList)>
  [  9] jmpifz [ 26] ............................ if not listp(gSwScoreSetupList) then
