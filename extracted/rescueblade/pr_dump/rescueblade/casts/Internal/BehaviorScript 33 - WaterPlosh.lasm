property this, Xpos, Ypos, ploshState, Yvel, grav, Xvel
global gXVel, gXOffset, gPaused, gPloshList, gPloshX

on beginSprite
  [  0] getmovieprop 22 ......................... <the currentSpriteNum>
  [  2] pusharglist 1 ........................... <the currentSpriteNum>
  [  4] extcall 21 .............................. <sprite(the currentSpriteNum)>
  [  6] setprop 20 .............................. this = sprite(the currentSpriteNum)
  [  8] pushint8 1000 ........................... <1000>
  [ 11] inv ..................................... <-1000>
  [ 12] pusharglist 1 ........................... <-1000>
  [ 14] extcall 33 .............................. <float(-1000)>
  [ 17] setprop 48 .............................. Xpos = float(-1000)
  [ 20] pushint8 1000 ........................... <1000>
  [ 23] inv ..................................... <-1000>
  [ 24] pusharglist 1 ........................... <-1000>
  [ 26] extcall 33 .............................. <float(-1000)>
  [ 29] setprop 38 .............................. Ypos = float(-1000)
  [ 32] pushint8 2 .............................. <2>
  [ 35] inv ..................................... <-2>
  [ 36] setprop 32 .............................. Yvel = -2
  [ 39] pushsymb 399 ............................ <#NULL>
  [ 42] setprop 624 ............................. ploshState = #NULL
  [ 45] getprop 20 .............................. <this>
  [ 47] pushint8 98 ............................. <98>
  [ 50] setobjprop 178 .......................... this.locZ = 98
  [ 53] getglobal 623 ........................... <gPloshList>
  [ 56] getprop 20 .............................. <this>
  [ 58] pusharglistnoret 2 ...................... <gPloshList, this>
  [ 60] objcall 418 ............................. gPloshList.add(this)
  [ 63] pushcons 0 .............................. <0.80000000000000004>
  [ 65] setprop 34 .............................. grav = 0.80000000000000004
  [ 68] pushzero ................................ <0>
  [ 69] setprop 44 .............................. Xvel = 0
  [ 72] getprop 20 .............................. <this>
  [ 74] pushint8 30 ............................. <30>
  [ 77] setobjprop 97 ........................... this.height = 30
  [ 80] getprop 20 .............................. <this>
  [ 82] pushint8 2 .............................. <2>
  [ 85] setobjprop 50 ........................... this.width = 2
  [ 88] getprop 20 .............................. <this>
  [ 90] getprop 48 .............................. <Xpos>
  [ 93] setobjprop 36 ........................... this.locH = Xpos
  [ 96] getprop 20 .............................. <this>
  [ 98] getprop 38 .............................. <Ypos>
  [101] setobjprop 37 ........................... this.locV = Ypos
  [104] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [250] ............................ if gPaused = 0 then
  [  8] getprop 624 ............................. <ploshState>
  [ 11] peek 0 .................................. case ploshState of
  [ 13] pushsymb 399 ............................ <#NULL>
  [ 16] eq
  [ 17] jmpifz [ 23] ............................ (case) #NULL:
  [ 20] jmp [248]
  [ 23] peek 0
  [ 25] pushsymb 625 ............................ <#PLOSH>
  [ 28] eq
  [ 29] jmpifz [248] ............................ (case) #PLOSH:
  [ 32] getprop 32 .............................. <Yvel>
  [ 35] getprop 34 .............................. <grav>
  [ 38] add ..................................... <Yvel + grav>
  [ 39] setprop 32 .............................. Yvel = Yvel + grav
  [ 42] getprop 48 .............................. <Xpos>
  [ 45] getglobal 47 ............................ <gXVel>
  [ 48] add ..................................... <Xpos + gXVel>
  [ 49] getglobal 55 ............................ <gXOffset>
  [ 52] add ..................................... <Xpos + gXVel + gXOffset>
  [ 53] getprop 44 .............................. <Xvel>
  [ 56] add ..................................... <Xpos + gXVel + gXOffset + Xvel>
  [ 57] setprop 48 .............................. Xpos = Xpos + gXVel + gXOffset + Xvel
  [ 60] getprop 38 .............................. <Ypos>
  [ 63] getprop 32 .............................. <Yvel>
  [ 66] add ..................................... <Ypos + Yvel>
  [ 67] setprop 38 .............................. Ypos = Ypos + Yvel
  [ 70] getprop 44 .............................. <Xvel>
  [ 73] pushcons 8 .............................. <0.97999999999999998>
  [ 75] mul ..................................... <Xvel * 0.97999999999999998>
  [ 76] setprop 44 .............................. Xvel = Xvel * 0.97999999999999998
  [ 79] getprop 32 .............................. <Yvel>
  [ 82] pushcons 16 ............................. <0.94999999999999996>
  [ 84] mul ..................................... <Yvel * 0.94999999999999996>
  [ 85] setprop 32 .............................. Yvel = Yvel * 0.94999999999999996
  [ 88] getprop 20 .............................. <this>
  [ 90] getprop 20 .............................. <this>
  [ 92] getobjprop 25 ........................... <this.rotation>
  [ 94] pushcons 24 ............................. <0.90000000000000002>
  [ 96] mul ..................................... <this.rotation * 0.90000000000000002>
  [ 97] setobjprop 25 ........................... this.rotation = this.rotation * 0.90000000000000002
  [ 99] getprop 20 .............................. <this>
  [101] getobjprop 50 ........................... <this.width>
  [104] pushint8 50 ............................. <50>
  [107] lt ...................................... <this.width < 50>
  [108] jmpifz [142] ............................ if this.width < 50 then / else
  [111] getprop 20 .............................. <this>
  [113] getprop 20 .............................. <this>
  [115] getobjprop 50 ........................... <this.width>
  [118] pushint8 4 .............................. <4>
  [121] add ..................................... <this.width + 4>
  [122] setobjprop 50 ........................... this.width = this.width + 4
  [125] getprop 20 .............................. <this>
  [127] getprop 20 .............................. <this>
  [129] getobjprop 97 ........................... <this.height>
  [132] pushint8 2 .............................. <2>
  [135] add ..................................... <this.height + 2>
  [136] setobjprop 97 ........................... this.height = this.height + 2
  [139] jmp [142]
  [142] getprop 20 .............................. <this>
  [144] getobjprop 37 ........................... <this.locV>
  [147] pushint8 280 ............................ <280>
  [150] gt ...................................... <this.locV > 280>
  [151] jmpifz [232] ............................ if this.locV > 280 then
  [154] getprop 20 .............................. <this>
  [156] getobjprop 36 ........................... <this.locH>
  [159] setglobal 632 ........................... gPloshX = this.locH
  [162] pushsymb 399 ............................ <#NULL>
  [165] setprop 624 ............................. ploshState = #NULL
  [168] getglobal 623 ........................... <gPloshList>
  [171] getprop 20 .............................. <this>
  [173] pusharglistnoret 2 ...................... <gPloshList, this>
  [175] objcall 418 ............................. gPloshList.add(this)
  [178] pushint8 1000 ........................... <1000>
  [181] inv ..................................... <-1000>
  [182] setprop 48 .............................. Xpos = -1000
  [185] pushint8 1000 ........................... <1000>
  [188] inv ..................................... <-1000>
  [189] setprop 38 .............................. Ypos = -1000
  [192] pushzero ................................ <0>
  [193] setprop 44 .............................. Xvel = 0
  [196] pushzero ................................ <0>
  [197] setprop 32 .............................. Yvel = 0
  [200] getprop 20 .............................. <this>
  [202] getprop 48 .............................. <Xpos>
  [205] setobjprop 36 ........................... this.locH = Xpos
  [208] getprop 20 .............................. <this>
  [210] getprop 38 .............................. <Ypos>
  [213] setobjprop 37 ........................... this.locV = Ypos
  [216] getprop 20 .............................. <this>
  [218] pushint8 2 .............................. <2>
  [221] setobjprop 50 ........................... this.width = 2
  [224] getprop 20 .............................. <this>
  [226] pushint8 30 ............................. <30>
  [229] setobjprop 97 ........................... this.height = 30
  [232] getprop 20 .............................. <this>
  [234] getprop 48 .............................. <Xpos>
  [237] setobjprop 36 ........................... this.locH = Xpos
  [240] getprop 20 .............................. <this>
  [242] getprop 38 .............................. <Ypos>
  [245] setobjprop 37 ........................... this.locV = Ypos
  [248] pop 1 ................................... end case
  [250] ret
end
