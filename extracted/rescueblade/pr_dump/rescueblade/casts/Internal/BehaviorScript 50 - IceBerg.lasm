  [126] pushcons 8 .............................. <0.0>
  [128] setprop 23 .............................. tiltAngle = 0.0
  [130] pushcons 16 ............................. <0.0>
  [132] setprop 795 ............................. tiltVel = 0.0
  [135] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [273] ............................ if gPaused = 0 then
  [  8] getprop 48 .............................. <Xpos>
