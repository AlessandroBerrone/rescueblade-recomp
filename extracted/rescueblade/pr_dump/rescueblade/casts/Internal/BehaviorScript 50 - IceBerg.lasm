  [134] jmpifz [212] ............................ if (abs(xDiff) < 60) and (yDiff > -90) and (yDiff < -20) then
  [137] getprop 761 ............................. <snowBlow>
  [140] getprop 341 ............................. <COPTER>
  [143] getobjprop 36 ........................... <COPTER.locH>
  [146] setobjprop 36 ........................... snowBlow.locH = COPTER.locH
  [149] getprop 761 ............................. <snowBlow>
  [152] getprop 20 .............................. <this>
  [154] getobjprop 37 ........................... <this.locV>
  [157] pushint8 20 ............................. <20>
  [160] sub ..................................... <this.locV - 20>
  [161] setobjprop 37 ........................... snowBlow.locV = this.locV - 20
  [164] getprop 761 ............................. <snowBlow>
  [167] pushzero ................................ <0>
  [168] setobjprop 25 ........................... snowBlow.rotation = 0
  [170] getlocal 0 .............................. <xDiff>
  [172] pushzero ................................ <0>
  [173] gt ...................................... <xDiff > 0>
  [174] jmpifz [196] ............................ if xDiff > 0 then / else
  [177] getprop 795 ............................. <tiltVel>
  [180] pushint8 90 ............................. <90>
  [183] getlocal 8 .............................. <yDiff>
  [185] sub ..................................... <90 - yDiff>
