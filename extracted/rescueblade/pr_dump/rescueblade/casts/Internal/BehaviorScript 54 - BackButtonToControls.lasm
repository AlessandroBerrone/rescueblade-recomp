property thisNum

on beginSprite
  [  0] getmovieprop 22 ......................... <the currentSpriteNum>
  [  2] setprop 554 ............................. thisNum = the currentSpriteNum
  [  5] ret
end

on mouseUp
  [  0] getprop 554 ............................. <thisNum>
  [  3] pusharglistnoret 1 ...................... <thisNum>
  [  5] extcall 31 .............................. put thisNum
  [  7] pusharglist 0 ........................... <>
  [  9] thebuiltin 555 .......................... <the rollover>
  [ 12] getprop 554 ............................. <thisNum>
  [ 15] eq ...................................... <the rollover = thisNum>
  [ 16] jmpifz [ 43] ............................ if the rollover = thisNum then
  [ 19] pushcons 0 .............................. <"ControlScreen">
  [ 21] pusharglistnoret 1 ...................... <"ControlScreen">
  [ 23] extcall 553 ............................. go("ControlScreen")
  [ 26] pushint8 2 .............................. <2>
  [ 29] pushint8 12 ............................. <12>
  [ 32] pushcons 8 .............................. <"Sfx">
  [ 34] pusharglist 2 ........................... <12, "Sfx">
  [ 36] extcall 27 .............................. <member(12, "Sfx")>
  [ 38] pusharglistnoret 2 ...................... <2, member(12, "Sfx")>
  [ 40] extcall 395 ............................. puppetSound(2, member(12, "Sfx"))
  [ 43] ret
end
