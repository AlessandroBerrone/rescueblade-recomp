property this, reflash
global gPaused

on beginSprite
  [  0] getmovieprop 22 ......................... <the currentSpriteNum>
  [  2] pusharglist 1 ........................... <the currentSpriteNum>
  [  4] extcall 21 .............................. <sprite(the currentSpriteNum)>
  [  6] setprop 20 .............................. this = sprite(the currentSpriteNum)
  [  8] getprop 20 .............................. <this>
  [ 10] pushint8 1000 ........................... <1000>
  [ 13] inv ..................................... <-1000>
  [ 14] setobjprop 37 ........................... this.locV = -1000
  [ 17] pushint8 2 .............................. <2>
  [ 20] pushint8 30 ............................. <30>
  [ 23] pushcons 0 .............................. <"Sfx">
  [ 25] pusharglist 2 ........................... <30, "Sfx">
  [ 27] extcall 27 .............................. <member(30, "Sfx")>
  [ 29] pusharglistnoret 2 ...................... <2, member(30, "Sfx")>
  [ 31] extcall 395 ............................. puppetSound(2, member(30, "Sfx"))
  [ 34] pushzero ................................ <0>
  [ 35] setprop 617 ............................. reflash = 0
  [ 38] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [219] ............................ if gPaused = 0 then
  [  8] getprop 20 .............................. <this>
  [ 10] getobjprop 37 ........................... <this.locV>
  [ 13] pushint8 1000 ........................... <1000>
  [ 16] inv ..................................... <-1000>
  [ 17] eq ...................................... <this.locV = -1000>
  [ 18] jmpifz [ 82] ............................ if this.locV = -1000 then
  [ 21] pushint8 200 ............................ <200>
  [ 24] pusharglist 1 ........................... <200>
  [ 26] extcall 408 ............................. <random(200)>
  [ 29] setlocal 0 .............................. X = random(200)
  [ 31] getlocal 0 .............................. <X>
  [ 33] pushint8 50 ............................. <50>
  [ 36] eq ...................................... <X = 50>
  [ 37] jmpifz [ 82] ............................ if X = 50 then
  [ 40] getprop 20 .............................. <this>
  [ 42] pushint8 512 ............................ <512>
  [ 45] pusharglist 1 ........................... <512>
  [ 47] extcall 408 ............................. <random(512)>
  [ 50] setobjprop 36 ........................... this.locH = random(512)
  [ 53] getprop 20 .............................. <this>
  [ 55] pushint8 123 ............................ <123>
  [ 58] pushint8 3 .............................. <3>
  [ 61] pusharglist 1 ........................... <3>
  [ 63] extcall 408 ............................. <random(3)>
  [ 66] pushint8 50 ............................. <50>
  [ 69] mul ..................................... <random(3) * 50>
  [ 70] add ..................................... <123 + (random(3) * 50)>
  [ 71] setobjprop 37 ........................... this.locV = 123 + (random(3) * 50)
  [ 74] getprop 20 .............................. <this>
  [ 76] pushint8 100 ............................ <100>
  [ 79] setobjprop 173 .......................... this.blend = 100
  [ 82] getprop 20 .............................. <this>
  [ 84] getobjprop 173 .......................... <this.blend>
  [ 87] pushzero ................................ <0>
  [ 88] gt ...................................... <this.blend > 0>
  [ 89] jmpifz [189] ............................ if this.blend > 0 then
  [ 92] getprop 20 .............................. <this>
  [ 94] getobjprop 173 .......................... <this.blend>
  [ 97] pushint8 40 ............................. <40>
  [100] eq ...................................... <this.blend = 40>
  [101] getprop 617 ............................. <reflash>
  [104] pushzero ................................ <0>
  [105] eq ...................................... <reflash = 0>
  [106] and ..................................... <(this.blend = 40) and (reflash = 0)>
  [107] jmpifz [124] ............................ if (this.blend = 40) and (reflash = 0) then
  [110] getprop 20 .............................. <this>
  [112] pushint8 100 ............................ <100>
  [115] setobjprop 173 .......................... this.blend = 100
  [118] pushint8 1 .............................. <1>
  [121] setprop 617 ............................. reflash = 1
  [124] getprop 20 .............................. <this>
  [126] getobjprop 173 .......................... <this.blend>
  [129] pushint8 10 ............................. <10>
  [132] gt ...................................... <this.blend > 10>
  [133] jmpifz [153] ............................ if this.blend > 10 then / else
  [136] getprop 20 .............................. <this>
  [138] getprop 20 .............................. <this>
  [140] getobjprop 173 .......................... <this.blend>
  [143] pushint8 10 ............................. <10>
  [146] sub ..................................... <this.blend - 10>
  [147] setobjprop 173 .......................... this.blend = this.blend - 10
  [150] jmp [189]
  [153] pushint8 2 .............................. <2>
  [156] pushint8 31 ............................. <31>
  [159] pushcons 8 .............................. <"Sfx">
  [161] pusharglist 2 ........................... <31, "Sfx">
  [163] extcall 27 .............................. <member(31, "Sfx")>
  [165] pusharglistnoret 2 ...................... <2, member(31, "Sfx")>
  [167] extcall 395 ............................. puppetSound(2, member(31, "Sfx"))
  [170] getprop 20 .............................. <this>
  [172] pushzero ................................ <0>
  [173] setobjprop 173 .......................... this.blend = 0
  [176] getprop 20 .............................. <this>
  [178] pushint8 1000 ........................... <1000>
  [181] inv ..................................... <-1000>
  [182] setobjprop 37 ........................... this.locV = -1000
  [185] pushzero ................................ <0>
  [186] setprop 617 ............................. reflash = 0
  [189] pushint8 2 .............................. <2>
  [192] pusharglist 1 ........................... <2>
  [194] extcall 394 ............................. <soundBusy(2)>
  [197] pushzero ................................ <0>
  [198] eq ...................................... <soundBusy(2) = 0>
  [199] jmpifz [219] ............................ if soundBusy(2) = 0 then
  [202] pushint8 2 .............................. <2>
  [205] pushint8 30 ............................. <30>
  [208] pushcons 16 ............................. <"Sfx">
  [210] pusharglist 2 ........................... <30, "Sfx">
  [212] extcall 27 .............................. <member(30, "Sfx")>
  [214] pusharglistnoret 2 ...................... <2, member(30, "Sfx")>
  [216] extcall 395 ............................. puppetSound(2, member(30, "Sfx"))
  [219] ret
end
