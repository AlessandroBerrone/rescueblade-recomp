property this, Xpos, swellAngle, radians, Ypos, mapXPos, loopWidth, loopX
global gXVel, gXOffset, gPaused, gTileIDList

on beginSprite
  [  0] pusharglist 0 ........................... <>
  [  2] extcall 41 .............................. <PI>
  [  5] pushint8 180 ............................ <180>
  [  8] div ..................................... <PI / 180>
  [  9] pusharglist 1 ........................... <PI / 180>
  [ 11] extcall 33 .............................. <float(PI / 180)>
  [ 14] setprop 40 .............................. radians = float(PI / 180)
  [ 17] getmovieprop 22 ......................... <the currentSpriteNum>
  [ 19] pusharglist 1 ........................... <the currentSpriteNum>
  [ 21] extcall 21 .............................. <sprite(the currentSpriteNum)>
  [ 23] setprop 20 .............................. this = sprite(the currentSpriteNum)
  [ 25] getglobal 180 ........................... <gTileIDList>
  [ 28] getobjprop 183 .......................... <gTileIDList.count>
  [ 31] pushint8 128 ............................ <128>
  [ 34] mul ..................................... <gTileIDList.count * 128>
  [ 35] setprop 54 .............................. loopWidth = gTileIDList.count * 128
  [ 38] getglobal 180 ........................... <gTileIDList>
  [ 41] getobjprop 183 .......................... <gTileIDList.count>
  [ 44] pushint8 128 ............................ <128>
  [ 47] mul ..................................... <gTileIDList.count * 128>
  [ 48] pushcons 0 .............................. <0.5>
  [ 50] mul ..................................... <gTileIDList.count * 128 * 0.5>
  [ 51] setprop 608 ............................. loopX = gTileIDList.count * 128 * 0.5
  [ 54] getprop 20 .............................. <this>
  [ 56] getobjprop 36 ........................... <this.locH>
  [ 59] pusharglist 1 ........................... <this.locH>
  [ 61] extcall 33 .............................. <float(this.locH)>
  [ 64] setprop 48 .............................. Xpos = float(this.locH)
  [ 67] getprop 20 .............................. <this>
  [ 69] getobjprop 37 ........................... <this.locV>
  [ 72] pusharglist 1 ........................... <this.locV>
  [ 74] extcall 33 .............................. <float(this.locV)>
  [ 77] setprop 38 .............................. Ypos = float(this.locV)
  [ 80] getprop 20 .............................. <this>
  [ 82] pushint8 50 ............................. <50>
  [ 85] setobjprop 178 .......................... this.locZ = 50
  [ 88] getprop 48 .............................. <Xpos>
  [ 91] pushint8 256 ............................ <256>
  [ 94] sub ..................................... <Xpos - 256>
  [ 95] setprop 366 ............................. mapXPos = Xpos - 256
  [ 98] pushzero ................................ <0>
  [ 99] setprop 62 .............................. swellAngle = 0
  [102] ret
end

on exitFrame
  [  0] getglobal 364 ........................... <gPaused>
  [  3] pushzero ................................ <0>
  [  4] eq ...................................... <gPaused = 0>
  [  5] jmpifz [126] ............................ if gPaused = 0 then
  [  8] getprop 48 .............................. <Xpos>
  [ 11] getglobal 47 ............................ <gXVel>
  [ 14] add ..................................... <Xpos + gXVel>
  [ 15] getglobal 55 ............................ <gXOffset>
  [ 18] add ..................................... <Xpos + gXVel + gXOffset>
  [ 19] setprop 48 .............................. Xpos = Xpos + gXVel + gXOffset
  [ 22] getprop 48 .............................. <Xpos>
  [ 25] getprop 608 ............................. <loopX>
  [ 28] gt ...................................... <Xpos > loopX>
  [ 29] jmpifz [ 42] ............................ if Xpos > loopX then
  [ 32] getprop 48 .............................. <Xpos>
  [ 35] getprop 54 .............................. <loopWidth>
  [ 38] sub ..................................... <Xpos - loopWidth>
  [ 39] setprop 48 .............................. Xpos = Xpos - loopWidth
  [ 42] getprop 48 .............................. <Xpos>
  [ 45] getprop 608 ............................. <loopX>
  [ 48] inv ..................................... <-loopX>
  [ 49] lt ...................................... <Xpos < -loopX>
  [ 50] jmpifz [ 63] ............................ if Xpos < -loopX then
  [ 53] getprop 48 .............................. <Xpos>
  [ 56] getprop 54 .............................. <loopWidth>
  [ 59] add ..................................... <Xpos + loopWidth>
  [ 60] setprop 48 .............................. Xpos = Xpos + loopWidth
  [ 63] getprop 20 .............................. <this>
  [ 65] getprop 48 .............................. <Xpos>
  [ 68] setobjprop 36 ........................... this.locH = Xpos
  [ 71] getprop 62 .............................. <swellAngle>
  [ 74] pushint8 2 .............................. <2>
  [ 77] add ..................................... <swellAngle + 2>
  [ 78] setprop 62 .............................. swellAngle = swellAngle + 2
  [ 81] getprop 62 .............................. <swellAngle>
  [ 84] pushint8 360 ............................ <360>
  [ 87] gt ...................................... <swellAngle > 360>
  [ 88] jmpifz [101] ............................ if swellAngle > 360 then
  [ 91] getprop 62 .............................. <swellAngle>
  [ 94] pushint8 360 ............................ <360>
  [ 97] sub ..................................... <swellAngle - 360>
  [ 98] setprop 62 .............................. swellAngle = swellAngle - 360
  [101] getprop 20 .............................. <this>
  [103] getprop 38 .............................. <Ypos>
  [106] pushint8 10 ............................. <10>
  [109] getprop 62 .............................. <swellAngle>
  [112] getprop 40 .............................. <radians>
  [115] mul ..................................... <swellAngle * radians>
  [116] pusharglist 1 ........................... <swellAngle * radians>
  [118] extcall 45 .............................. <cos(swellAngle * radians)>
  [121] mul ..................................... <10 * cos(swellAngle * radians)>
  [122] add ..................................... <Ypos + (10 * cos(swellAngle * radians))>
  [123] setobjprop 37 ........................... this.locV = Ypos + (10 * cos(swellAngle * radians))
  [126] ret
end
