global gProControls

on exitFrame me
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 1 ............................ <the frame>
  [  4] pusharglistnoret 1 ...................... <the frame>
  [  6] extcall 2 ............................... go(the frame)
  [  8] ret
end

on mouseUp
  [  0] pusharglist 0 ........................... <>
  [  2] thebuiltin 13 ........................... <the rollover>
  [  4] peek 0 .................................. case the rollover of
  [  6] pushint8 10 ............................. <10>
  [  9] eq
  [ 10] jmpifz [ 41] ............................ (case) 10:
  [ 13] pushzero ................................ <0>
  [ 14] setglobal 14 ............................ gProControls = 0
  [ 16] pushcons 0 .............................. <"menuScreen">
  [ 18] pusharglistnoret 1 ...................... <"menuScreen">
  [ 20] extcall 2 ............................... go("menuScreen")
  [ 22] pushint8 2 .............................. <2>
  [ 25] pushint8 12 ............................. <12>
  [ 28] pushcons 8 .............................. <"Sfx">
  [ 30] pusharglist 2 ........................... <12, "Sfx">
  [ 32] extcall 16 .............................. <member(12, "Sfx")>
  [ 34] pusharglistnoret 2 ...................... <2, member(12, "Sfx")>
  [ 36] extcall 15 .............................. puppetSound(2, member(12, "Sfx"))
  [ 38] jmp [ 77]
  [ 41] peek 0
  [ 43] pushint8 11 ............................. <11>
  [ 46] eq
  [ 47] jmpifz [ 77] ............................ (case) 11:
  [ 50] pushint8 1 .............................. <1>
  [ 53] setglobal 14 ............................ gProControls = 1
  [ 55] pushcons 16 ............................. <"menuScreen">
  [ 57] pusharglistnoret 1 ...................... <"menuScreen">
  [ 59] extcall 2 ............................... go("menuScreen")
  [ 61] pushint8 2 .............................. <2>
  [ 64] pushint8 12 ............................. <12>
  [ 67] pushcons 24 ............................. <"Sfx">
  [ 69] pusharglist 2 ........................... <12, "Sfx">
  [ 71] extcall 16 .............................. <member(12, "Sfx")>
  [ 73] pusharglistnoret 2 ...................... <2, member(12, "Sfx")>
  [ 75] extcall 15 .............................. puppetSound(2, member(12, "Sfx"))
  [ 77] pop 1 ................................... end case
  [ 79] ret
end
